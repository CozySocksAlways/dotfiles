alias ele='cd /home/jos/repos/elephant.git'

alias task='cd /home/jos/repos/tasks-diary'

alias scs='cd /home/jos/.config/i3/screen_scripts/'

alias repos='cd /home/jos/repos/'

alias sand='cd /home/jos/sandbox'

alias tasks='nvim --listen /tmp/tasks-nvim.sock /home/jos/repos/tasks-diary/2026/oct_26.md'

# Temporary alias
alias ci='cd /home/jos/repos/elephant/.github/workflows/'

pushsync() {
	git push "$@"
	rsync -av --delete --exclude='.git' \
	/home/jos/repos/gpu-convex-polytope-sampling/ nfzj:/home/jos_l/repos/paper/gpu-convex-polytope-sampling/
}

paperpush() {
	git push "$@" origin && echo "origin success"
	git push "$@" jugit && echo "jugit success"
	git push "$@" ibt72 && echo "ibt72 success"
	git push "$@" ham && echo "ham success"
}

alias paper='cd $HOME/repos/paper'

# sync gpu_sampling onto ibt82
alias gpusync="rsync --exclude='.git/' -rv /home/jos/repos/gpu-convex-polytope-sampling/ nfzj:/home/jos_l/repos/paper/gpu-convex-polytope-sampling/"


# Miner
minerpush() {
	git push "$@" origin && echo "origin success"
	git push "$@" dgx && echo "dgx success"
}

# Kokoro-tts Stream
kokoro() {
	kokoro-tts \
	"$@" \
	--model /home/jos/repos/diy/kokoros/model/kokoro-v1.0.onnx \
	--voices /home/jos/repos/diy/kokoros/model/voices-v1.0.bin
}

alias coco="cd /home/jos/repos/coco"
alias wte="cd /home/jos/repos/elephant.git"
alias cgc="cd /home/jos/repos/elephant.git/csg"

source /home/jos/repos/dotfiles/apis

# Datalad
datalad(){
	podman run --rm \
			-it \
			--env 'HOME=/home/user/' \
			--mount type=bind,src=/home/jos/repos/dotfiles/.gitconfig,dst=/home/user/.gitconfig \
			--mount type=bind,src="$PWD",dst="$PWD" \
			-w "$PWD" \
			datalad:latest "$@"
}

git-annex(){
	podman run --rm \
			-it \
			--env 'HOME=/home/user/' \
			--mount type=bind,src=/home/jos/repos/dotfiles/.gitconfig,dst=/home/user/.gitconfig \
			--mount type=bind,src="$PWD",dst="$PWD" \
			-w "$PWD" \
			--entrypoint="git-annex" \
			datalad:latest "$@"
}

# Usefull vairables
export GHELE=NeuralEnsemble/elephant

# Latex
alias mklatex='podman run --rm --mount type=bind,src=$(pwd),dst=/work -w /work texlive/texlive:latest latexmk -auxdir=build -pdf main.tex'
